{
  "name": "xls-to-11ty-datafiles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "xls-to-11ty": "./bin/xls-to-11ty.mjs"
  },
  "scripts": {
    "convert": "node ./bin/xls-to-11ty.mjs",
    "build": "eleventy",
    "start": "eleventy --serve",
    "images": "node ./bin/generate-images.mjs",
    "deploy": "npm run build && npm run deploy:upload",
    "deploy:upload": "node ./bin/upload-to-bunny.mjs",
    "deploy:check": "node ./bin/upload-to-bunny.mjs --check"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "js-yaml": "^4.1.0",
    "minisearch": "^7.2.0",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "upload-to-bunny": "^2.1.1"
  }
}
