---
layout: base.njk
title: Locations
---
<section class="page-heading" aria-labelledby="page-title">
  <p class="eyebrow">Subcollections</p>
  <h1 id="page-title">Locations</h1>
  <p>Browse images grouped by location.</p>
</section>
<ol class="taxonomy-list">
{% for key in lookups.locations | keys %}
  {% set label = key | labelFor(lookups.locations) %}
  <li><a href="/locations/{{ key | slug }}/"><span>{{ label }}</span><small>{{ key }}</small></a></li>
{% endfor %}
</ol>
