<!doctype html>
<html lang="en">
<head>
  {% set canonicalUrl = site.host + page.url %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ canonicalUrl | escape }}">
  <meta property="og:url" content="{{ canonicalUrl | escape }}">
  {% if catalogueItemPage %}
    {% set ogTitle = title or Title or page.fileSlug %}
    {% set ogCreator = creator | labelFor %}
    {% set ogDate = (date_start_prefix or Date_start_prefix) | dateComposite(date_start or Date_start, date_end_prefix or Date_end_prefix, date_end or Date_end) %}
    {% set ogImage = image_file | imageDetailUrl %}
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="{{ site.title | escape }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="{{ ogTitle | escape }}">
  <meta property="og:description" content="{{ (ogCreator or site.ui.emptyValue) | escape }}, {{ ogTitle | escape }}, {{ ogDate | escape }}">
  {% if ogImage %}<meta property="og:image" content="{{ (site.host + ogImage) | escape }}">
  <meta property="og:image:alt" content="{{ ogTitle | escape }}">{% endif %}
  {% endif %}
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="site-shell">
    <header class="site-header">
      <div class="masthead">
        <a class="brand" href="/" aria-label="{{ site.title }} home">
          <span>
          <strong>{{ site.title }}</strong>
            <small>{{ site.subtitle }}</small>
          </span>
        </a>

        <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label="Open menu"><span aria-hidden="true">☰</span></button>

        <a class="about-link" href="/about/">Practical information</a>

        <div class="header-tools" id="site-menu" data-mobile-menu>
          <nav class="nav-list" aria-label="Collection navigation">
            <a class="mobile-about-link" href="/about/">Practical information</a>
            <a href="/">All images</a>
            {% for taxonomy in site.taxonomies %}
              <a href="{{ taxonomy.url }}">{{ taxonomy.label }}</a>
            {% endfor %}
          </nav>
          <form class="search-placeholder" role="search" action="/search/" method="get">
            <label class="visually-hidden" for="catalogue-search">Search the catalogue</label>
            <input id="catalogue-search" name="q" type="search" placeholder="Search" autocomplete="off">
            <button class="visually-hidden" type="submit">Search</button>
          </form>
        </div>
      </div>
    </header>

    <div class="site-main">
      <main id="main-content" tabindex="-1">
        {{ content | safe }}
      </main>
    </div>
  </div>
  <script src="/assets/js/catalogue.js" defer></script>
  {% if searchPage %}<script src="/assets/js/search.js" defer></script>{% endif %}
</body>
</html>
