---
layout: base.njk
---
{% set titleText = title or Title or page.fileSlug %}
{% set img = image_file | imageDetailUrl %}
{% set srcset = image_file | imageSrcset %}
{% set itemId = page | catalogueId %}
{% set permalinkUrl = site.host + '/s/' + itemId %}
{% set dateText = (date_start_prefix or Date_start_prefix) | dateComposite(date_start or Date_start, date_end_prefix or Date_end_prefix, date_end or Date_end) %}
{% set dimensionText = (dimensions_height or Dimensions_Height) | dimensions(dimensions_width or Dimensions_Width) %}
{% macro valueList(value, lookup) %}
  {% set values = value | asArray %}
  {% if values.length > 1 %}
    <ul class="plain-list">
      {% for v in values %}<li>{% if lookup %}{{ v | labelFor(lookup) }}{% else %}{{ v }}{% endif %}</li>{% endfor %}
    </ul>
  {% elif values.length == 1 %}
    {% if lookup %}{{ values[0] | labelFor(lookup) }}{% else %}{{ values[0] }}{% endif %}
  {% else %}
    <span class="empty-value">{{ site.ui.emptyValue }}</span>
  {% endif %}
{% endmacro %}
{% macro row(label, value, lookup) %}
  <div>
    <dt>{{ label }}</dt>
    <dd>{{ valueList(value, lookup) }}</dd>
  </div>
{% endmacro %}
{% macro codeLabelList(value, lookup) %}
  {% set values = value | asArray %}
  {% if values.length > 1 %}
    <ul class="plain-list">
      {% for code in values %}<li>{{ code }}: {{ code | labelFor(lookup) }}</li>{% endfor %}
    </ul>
  {% elif values.length == 1 %}
    {{ values[0] }}: {{ values[0] | labelFor(lookup) }}
  {% else %}
    <span class="empty-value">{{ site.ui.emptyValue }}</span>
  {% endif %}
{% endmacro %}
{% macro relationList(items) %}
  {% if items.length %}
    <ul class="plain-list relation-list">
      {% for item in items %}
        {% set relatedCreator = item.data.creator | labelFor %}
        <li>
          <a href="{{ item.url }}"><em>{{ relatedCreator or site.ui.emptyValue }}</em>, {{ item | titleFor }}, {{ item | dateRange }}</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <span class="empty-value">{{ site.ui.emptyValue }}</span>
  {% endif %}
{% endmacro %}
<article class="detail-view" aria-labelledby="item-title">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">All images</a><span aria-hidden="true">/</span><span id="item-title">{{ titleText }}</span>
  </nav>

  <div class="detail-layout">
    <figure class="detail-image"{% if img %} data-image-viewer{% endif %}>
      {% if img %}
        <img src="{{ img }}"{% if srcset %} srcset="{{ srcset }}" sizes="(min-width: 900px) 45vw, 100vw"{% endif %} data-original-src="{{ img }}" alt="{{ titleText }}" draggable="false">
        <button class="image-fullscreen-toggle" type="button" data-image-fullscreen-toggle aria-label="View image fullscreen" aria-pressed="false" title="View image fullscreen"><span aria-hidden="true">⛶</span></button>
      {% else %}
        <div class="placeholder-image placeholder-large" role="img" aria-label="No image available for {{ titleText }}">No image available</div>
      {% endif %}
    </figure>

    <div class="detail-copy">
      <section class="tab-card" data-tabs aria-label="Catalogue item details">
        <div class="tab-list" role="tablist" aria-label="Detail sections">
          <button id="tab-overview" class="tab-button" type="button" role="tab" aria-selected="true" aria-controls="panel-overview">Overview</button>
          <button id="tab-inscriptions" class="tab-button" type="button" role="tab" aria-selected="false" aria-controls="panel-inscriptions" tabindex="-1">Inscriptions</button>
          <button id="tab-related" class="tab-button" type="button" role="tab" aria-selected="false" aria-controls="panel-related" tabindex="-1">Related</button>
          <button id="tab-literature" class="tab-button" type="button" role="tab" aria-selected="false" aria-controls="panel-literature" tabindex="-1">Literature</button>
        </div>

        <div id="panel-overview" class="tab-panel" role="tabpanel" aria-labelledby="tab-overview">
          <dl class="metadata-list">
            {{ row('Title', title) }}
            {{ row('Creator', creator) }}
            {{ row('Former attribution', former_attribution or formerattribution) }}
            {{ row('Signature', signatures or signature) }}
            {{ row('Date', dateText) }}
            <div>
              <dt>Location</dt>
              <dd>{{ valueList(place_creation or location, lookups.locations) }}{% if place_creation_extra or location_extra %}<span class="field-note">{{ place_creation_extra or location_extra }}</span>{% endif %}</dd>
            </div>
            {{ row('Medium', medium) }}
            {{ row('Dimensions', dimensionText) }}
            {{ row('Classification', classification) }}
            {{ row('Collection', collection) }}
            {{ row('Inventory number', inventory_number or inventorynumber) }}
            {{ row('Credits and rights', credits_and_rights or creditsandrights) }}
            <div>
              <dt>Permalink</dt>
              <dd><a href="{{ permalinkUrl }}">{{ permalinkUrl }}</a></dd>
            </div>
          </dl>
        </div>

        <div id="panel-inscriptions" class="tab-panel" role="tabpanel" aria-labelledby="tab-inscriptions" hidden>
          <div class="prose-value">
            {% if content %}{{ content | safe }}{% else %}<p class="empty-value">No inscriptions recorded.</p>{% endif %}
          </div>
        </div>

        <div id="panel-related" class="tab-panel" role="tabpanel" aria-labelledby="tab-related" hidden>
          {% set relatedItems = collections.metadata | relationPeers(page, 'related_items') %}
          {% set artisticRelations = collections.metadata | relationPeers(page, 'artistic_relations') %}
          <dl class="metadata-list">
            {{ row('Part of', part_of or Part_of) }}
            <div>
              <dt>Related items</dt>
              <dd>{{ relationList(relatedItems) }}</dd>
            </div>
            <div>
              <dt>Artistic relations</dt>
              <dd>{{ relationList(artisticRelations) }}</dd>
            </div>
            <div>
              <dt>Iconclass</dt>
              <dd>{{ codeLabelList(iconclass, lookups.iconclass) }}</dd>
            </div>
            {{ row('Subjects', subject or subjects, lookups.subjects) }}
          </dl>
        </div>

        <div id="panel-literature" class="tab-panel" role="tabpanel" aria-labelledby="tab-literature" hidden>
          <div class="prose-value">
            {% set references = literature | asArray %}
            {% if references.length %}
              <div class="literature-list">
                {% for reference in references %}<div>{{ reference | linkifyUrls | safe }}</div>{% endfor %}
              </div>
            {% else %}
              <p class="empty-value">No literature recorded.</p>
            {% endif %}
          </div>
        </div>
      </section>
    </div>
  </div>
</article>
